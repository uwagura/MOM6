name: Sync Upstream

on:
  schedule:
    # 1:45 PM EST is 18:45 UTC (Winter)
    - cron: '45 18 * * 1'
  workflow_dispatch:

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout your fork
        uses: actions/checkout@v4
        with:
          ref: dev/cefi
          fetch-depth: 0
          
      - name: Add upstream remote
        run: |
          git remote add gfdl https://github.com/NOAA-GFDL/MOM6.git
          git fetch gfdl dev/gfdl
          
      - name: Check for upstream changes
        id: check
        run: |
          BEHIND=$(git rev-list --count HEAD..gfdl/dev/gfdl)
          echo "commits_behind=$BEHIND" >> $GITHUB_OUTPUT
          
          if [ "$BEHIND" -gt 0 ]; then
            echo "has_changes=true" >> $GITHUB_OUTPUT
          else
            echo "has_changes=false" >> $GITHUB_OUTPUT
          fi
          
      - name: Check if PR already exists
        if: steps.check.outputs.has_changes == 'true'
        id: check_pr
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          # Check for existing PR from upstream:main to your main
          PR_EXISTS=$(gh pr list --head gfdl:dev/gfdl --base dev/cefi --json number --jq length)
          echo "pr_exists=$PR_EXISTS" >> $GITHUB_OUTPUT
          
      - name: Create Pull Request
        if: steps.check.outputs.has_changes == 'true' && steps.check_pr.outputs.pr_exists == '0'
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          gh pr create \
            --repo ${{ github.repository }} \
            --head gfdl:dev/gfdl \
            --base dev/cefi \
            --title "Sync dev/cefi with dev/gfdl ($(date +%Y-%m-%d))" \
            --body "This PR merges the latest changes from the dev/gfdl into dev/gfdl, provided that they do not change answers
            
            **Commits behind:** ${{ steps.check.outputs.commits_behind }}
            
            Please review and test before merging." \
            --label upstream-sync
            --add-reviewer uwagura
